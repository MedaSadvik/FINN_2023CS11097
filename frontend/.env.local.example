# Copy to .env.local and fill in. Never commit .env.local or paste these in chat.
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: lets signed-in users build research for a company on request (server-only, never NEXT_PUBLIC_).
# A fine-grained GitHub token with ONE permission: Actions (read and write) on this repository.
BUILD_GITHUB_TOKEN=
# The branch whose workflow file should run, and the repo (defaults: main, MedaSadvik/FINN_2023CS11097).
BUILD_GITHUB_REF=main
BUILD_GITHUB_REPO=MedaSadvik/FINN_2023CS11097
