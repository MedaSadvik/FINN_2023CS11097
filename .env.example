# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=      # server only. Never expose to the browser.
SUPABASE_ANON_KEY=
GEMINI_API_KEY=            # from Google AI Studio (not the Jio app plan)
# Model IDs change often and a listed model may be closed. Run: python scripts/list_models.py
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-flash
# Tried in order if the main model is overloaded or closed:
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.7-flash

# DEV TESTING ONLY (not used for anything we ship): any OpenAI-compatible endpoint, e.g. Hyde's GLM.
# Check the provider's terms first. Leave LLM_PROVIDER unset for normal (Gemini) runs.
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=https://.../v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
